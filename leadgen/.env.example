# LEADGEN configuration — copy to leadgen/.env and fill in what you use.
# Everything is optional: with no .env the app runs on a local JSON file,
# demo AI scoring, and no email alerts.

# --- Claude (AI scoring + outreach drafting) ---
# Without a key the app uses a built-in demo scorer and template DMs.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-4-8

# --- Supabase Postgres (persistent database) ---
# Run leadgen/schema.sql in the Supabase SQL Editor first.
# Use the service_role secret key (NOT the anon key). Strongly recommended
# for any hosted deploy — the local JSON file is wiped on free-tier restarts.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Resend (email alert when a new lead is captured) ---
# Free key at resend.com. Without one, new leads still land in the CRM and
# show in the dashboard activity feed.
RESEND_API_KEY=
# RESEND_FROM=Leadgen <onboarding@resend.dev>

# --- Pre-seeded login password (recommended for hosted deploys) ---
# If set, the app creates its password from this at boot instead of showing
# the public first-run setup screen. Min 8 characters.
LEADGEN_PASSWORD=

# PORT=4179
